{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependências"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "KUBECTL_VERSION no hook das ferramentas Kubernetes",
      "managerFilePatterns": [
        "/config/hooks/live/0500-k8s-tools\\.hook\\.chroot$/"
      ],
      "matchStrings": [
        "KUBECTL_VERSION=\"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes"
    },
    {
      "customType": "regex",
      "description": "HELM_VERSION no hook das ferramentas Kubernetes",
      "managerFilePatterns": [
        "/config/hooks/live/0500-k8s-tools\\.hook\\.chroot$/"
      ],
      "matchStrings": [
        "HELM_VERSION=\"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "helm/helm"
    },
    {
      "customType": "regex",
      "description": "K9S_VERSION no hook das ferramentas Kubernetes",
      "managerFilePatterns": [
        "/config/hooks/live/0500-k8s-tools\\.hook\\.chroot$/"
      ],
      "matchStrings": [
        "K9S_VERSION=\"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "derailed/k9s"
    },
    {
      "customType": "regex",
      "description": "KIND_VERSION no hook das ferramentas Kubernetes",
      "managerFilePatterns": [
        "/config/hooks/live/0500-k8s-tools\\.hook\\.chroot$/"
      ],
      "matchStrings": [
        "KIND_VERSION=\"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/kind"
    }
  ]
}
